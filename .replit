modules = ["python-3.12", "web", "nodejs-20"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "React Frontend"

[[workflows.workflow]]
name = "React Frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/dev.sh"
waitForPort = 5173

[[workflows.workflow]]
name = "Streamlit (legacy)"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run explorer/knowledge_explorer.py --server.address 0.0.0.0 --server.port 5000 --server.headless true --browser.gatherUsageStats false"
waitForPort = 5000

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 5000
externalPort = 8080
